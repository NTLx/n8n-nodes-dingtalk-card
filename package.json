{
  "name": "n8n-nodes-dingtalk-card",
  "version": "0.8.0",
  "description": "DingTalk Card Platform lifecycle nodes for n8n",
  "license": "MIT",
  "homepage": "https://github.com/NTLx/n8n-nodes-dingtalk-card#readme",
  "keywords": [
    "n8n-community-node-package",
    "dingtalk",
    "interactive-card"
  ],
  "author": {
    "name": "NTLx",
    "email": "lx3325360@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NTLx/n8n-nodes-dingtalk-card.git"
  },
  "bugs": {
    "url": "https://github.com/NTLx/n8n-nodes-dingtalk-card/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.cjs",
    "prepack": "npm run build",
    "verify:package": "npm run build && node scripts/verify-package.cjs"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DingTalkCardApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/DingTalkCard/DingTalkCard.node.js",
      "dist/nodes/DingTalkCardTrigger/DingTalkCardTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.54.2",
    "@types/node": "^22.0.0",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "n8n-workflow": "2.44.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
